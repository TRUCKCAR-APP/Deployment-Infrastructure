# Copie este archivo como .env y complete los valores (no versionar .env).
# Secreto JWT compartido (Base64, >= 256 bits). Generarlo con: openssl rand -base64 48
TRUCKCAR_JWT_SECRET=
# ADMIN inicial: User-Identity lo crea al arrancar si no existe ninguno (contraseña de 12 a 72 caracteres)
TRUCKCAR_ADMIN_EMAIL=
TRUCKCAR_ADMIN_PASSWORD=
# Opcionales
# Contraseñas de los roles de base de datos por servicio (se aplican al crear el rol; valores de desarrollo por defecto)
# TRUCKCAR_DB_PASSWORD_USER_IDENTITY=
# TRUCKCAR_DB_PASSWORD_LOAD_ALLOCATION=
# TRUCKCAR_DB_PASSWORD_FLEETS_DRIVERS=
# TRUCKCAR_DB_PASSWORD_COMMUNITY_ALERTS=
# TRUCKCAR_DB_PASSWORD_ROUTING_RESTRICTIONS=
# TRUCKCAR_DB_PASSWORD_FLEET_ALLOCATION=
# TRUCKCAR_DB_PASSWORD_ROUTE_AI_AGENT=
# TRUCKCAR_DB_PASSWORD_NOTIFICATIONS=
# Almacenamiento S3 de evidencias de entrega (POD)
# TRUCKCAR_S3_ACCESS_KEY=
# TRUCKCAR_S3_SECRET_KEY=
# TRUCKCAR_S3_PUBLIC_ENDPOINT=http://localhost:5500
# AZURE_OPENAI_ENDPOINT=https://<recurso>.openai.azure.com/
# AZURE_OPENAI_KEY=
# TRUCKCAR_ASSIGNMENT_RESPONSE_TIMEOUT_MINUTES=60
# TRUCKCAR_NOTIFICATIONS_API_KEY=
# Carpeta local del repo truckcar-frontend (por defecto ./truckcar-frontend)
# TRUCKCAR_FRONTEND_DIR=./truckcar-frontend
