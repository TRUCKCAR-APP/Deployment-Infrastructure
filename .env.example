# Copie este archivo como .env y complete los valores (no versionar .env).
# Secreto JWT compartido (Base64, >= 256 bits). Generarlo con: openssl rand -base64 48
TRUCKDAR_JWT_SECRET=
# Opcionales
# AZURE_OPENAI_ENDPOINT=https://<recurso>.openai.azure.com/
# AZURE_OPENAI_KEY=
# TRUCKDAR_ASSIGNMENT_RESPONSE_TIMEOUT_MINUTES=60
# TRUCKDAR_NOTIFICATIONS_API_KEY=
# Carpeta local del repo truckdar-frontend (por defecto ./truckdar-frontend)
# TRUCKDAR_FRONTEND_DIR=./truckdar-frontend
