# Copie este archivo como .env y complete los valores (no versionar .env).
# Secreto JWT compartido (Base64, >= 256 bits). Generarlo con: openssl rand -base64 48
TRUCKCAR_JWT_SECRET=
# Opcionales
# AZURE_OPENAI_ENDPOINT=https://<recurso>.openai.azure.com/
# AZURE_OPENAI_KEY=
# TRUCKCAR_ASSIGNMENT_RESPONSE_TIMEOUT_MINUTES=60
# TRUCKCAR_NOTIFICATIONS_API_KEY=
# Carpeta local del repo truckcar-frontend (por defecto ./truckcar-frontend)
# TRUCKCAR_FRONTEND_DIR=./truckcar-frontend
