# =====================================================================================================================
# TruckCar - variables de entorno de docker-compose (desarrollo local)
#
# Genere .env con:  bash scripts/init-env.sh   (Windows: .\scripts\init-env.ps1)
#   Copia este archivo y rellena con un valor aleatorio cada variable vacía marcada [secreto]. Con un .env existente
#   solo agrega las variables que le falten. .env nunca se versiona.
#
# Ningún archivo versionado contiene credenciales: docker-compose.yml exige cada [secreto] (no arranca sin él).
#
# Producción (AWS EKS / Azure AKS): los mismos valores viven en AWS Secrets Manager o Azure Key Vault y llegan a los
# pods como Secret de Kubernetes mediante External Secrets Operator (k8s/base/secrets/ y k8s/overlays/*/). La clave
# remota de cada secreto se indica como "remoto: <clave>"; en Azure Key Vault los "/" pasan a ser "-".
# =====================================================================================================================

# ── Identidad y tokens ───────────────────────────────────────────────────────────────────────────────────────────────
# [secreto] remoto: truckcar/jwt-secret
# Base64 de >= 256 bits compartido por User-Identity, api-gateway y Notifications (openssl rand -base64 48).
TRUCKCAR_JWT_SECRET=
# ADMIN inicial: User-Identity lo crea al arrancar si no existe ninguno. Sin correo no se crea (contraseña 12-72).
TRUCKCAR_ADMIN_EMAIL=
# [secreto] remoto: truckcar/admin-password
TRUCKCAR_ADMIN_PASSWORD=

# ── PostgreSQL / PgBouncer ───────────────────────────────────────────────────────────────────────────────────────────
# Las contraseñas se aplican al crear cada rol (base nueva). Con un volumen existente use las que ya tiene; rotarlas
# es un ALTER ROLE manual (README, "Rotación de credenciales").
# [secreto] remoto: truckcar/db/admin-password
# Superusuario truckcar_admin: solo lo usan db-init (crea roles y esquemas) y el auth_query de PgBouncer.
TRUCKCAR_DB_ADMIN_PASSWORD=
# [secreto] remoto: truckcar/db/user-identity
TRUCKCAR_DB_PASSWORD_USER_IDENTITY=
# [secreto] remoto: truckcar/db/load-allocation
TRUCKCAR_DB_PASSWORD_LOAD_ALLOCATION=
# [secreto] remoto: truckcar/db/fleets-drivers
TRUCKCAR_DB_PASSWORD_FLEETS_DRIVERS=
# [secreto] remoto: truckcar/db/community-alerts
TRUCKCAR_DB_PASSWORD_COMMUNITY_ALERTS=
# [secreto] remoto: truckcar/db/routing-restrictions
TRUCKCAR_DB_PASSWORD_ROUTING_RESTRICTIONS=
# [secreto] remoto: truckcar/db/fleet-allocation
TRUCKCAR_DB_PASSWORD_FLEET_ALLOCATION=
# [secreto] remoto: truckcar/db/route-ai-agent
TRUCKCAR_DB_PASSWORD_ROUTE_AI_AGENT=
# [secreto] remoto: truckcar/db/notifications
TRUCKCAR_DB_PASSWORD_NOTIFICATIONS=
# [secreto] remoto: truckcar/pgbouncer/stats-password
# Usuario pgbouncer_stats de la consola de PgBouncer (solo SHOW POOLS/STATS) para pgbouncer-exporter.
TRUCKCAR_PGBOUNCER_STATS_PASSWORD=

# ── Almacenamiento de objetos (evidencias de entrega, POD) ───────────────────────────────────────────────────────────
# En local, credenciales raíz de RustFS. En AWS se usa el rol IAM del pod (IRSA) y estas variables quedan vacías.
TRUCKCAR_S3_ACCESS_KEY=truckcar
# [secreto] remoto: truckcar/s3/secret-key
TRUCKCAR_S3_SECRET_KEY=
# Base con la que se firman las URLs que usa la PWA (en local, el nginx del frontend sirve /pod-media/).
TRUCKCAR_S3_PUBLIC_ENDPOINT=http://localhost:5500

# ── Seguimiento público de envíos ────────────────────────────────────────────────────────────────────────────────────
# [secreto] remoto: truckcar/tracking/link-secret
# Clave HMAC-SHA256 de los enlaces públicos de seguimiento (Load-Allocation). Rotarla invalida los enlaces emitidos.
TRUCKCAR_TRACKING_LINK_SECRET=
# PWA que abre los enlaces (?track=<token>): el dominio público en producción.
TRUCKCAR_PUBLIC_APP_URL=http://localhost:5500/

# ── Orígenes del navegador (CORS y WebSocket) ────────────────────────────────────────────────────────────────────────
# Desde dónde puede llamar la PWA al api-gateway y abrir /ws-telemetry en fleets-drivers: lista separada por comas,
# sin barra final. Sin definir, docker-compose usa http://localhost:5500,http://127.0.0.1:5500 (el nginx de la PWA).
# Con el perfil prod (Kubernetes) el gateway no arranca si hay un comodín o localhost.
# TRUCKCAR_CORS_ALLOWED_ORIGINS=https://app.truckcar.co

# ── Mensajería ───────────────────────────────────────────────────────────────────────────────────────────────────────
# Usuario de RabbitMQ (relay STOMP de la telemetría en vivo); se crea con el primer arranque del volumen.
TRUCKCAR_STOMP_RELAY_LOGIN=truckcar
# [secreto] remoto: truckcar/rabbitmq/passcode
TRUCKCAR_STOMP_RELAY_PASSCODE=

# ── Observabilidad ───────────────────────────────────────────────────────────────────────────────────────────────────
# Grafana en http://127.0.0.1:3000 (usuario admin por defecto).
TRUCKCAR_GRAFANA_ADMIN_USER=admin
# [secreto] remoto: truckcar/grafana/admin-password
TRUCKCAR_GRAFANA_ADMIN_PASSWORD=
# Fracción de peticiones trazadas (1.0 en local; 0.1 suele bastar en producción).
TRUCKCAR_TRACING_SAMPLING_PROBABILITY=1.0
# Etiqueta deployment.environment de las trazas.
TRUCKCAR_ENVIRONMENT=local

# ── Integraciones opcionales ─────────────────────────────────────────────────────────────────────────────────────────
# Route-AI-agent: sin estas variables la interpretación de alertas usa el fallback por reglas.
# Recurso de Azure OpenAI con un despliegue de gpt-4.1-mini (gpt-4o-mini ya no se puede desplegar). Con una cuenta de
# estudiante, créelo en East US 2 o Sweden Central: en East US la cuota es 0. En EKS la clave va al Secret como
# azure-openai-key (k8s/README.md).
# AZURE_OPENAI_ENDPOINT=https://<recurso>.openai.azure.com/
# remoto: truckcar/azure-openai/key
# AZURE_OPENAI_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
# Notifications: clave de las llamadas entre servicios (vacía = deshabilitada). remoto: truckcar/notifications/api-key
# TRUCKCAR_NOTIFICATIONS_API_KEY=

# ── Ajustes de desarrollo ────────────────────────────────────────────────────────────────────────────────────────────
# TRUCKCAR_ASSIGNMENT_RESPONSE_TIMEOUT_MINUTES=60
# Carpeta local del repo truckcar-frontend (por defecto ./truckcar-frontend)
# TRUCKCAR_FRONTEND_DIR=./truckcar-frontend
